{
  "name": "VitalPulse Analytics",
  "compatibilityLevel": 1567,
  "model": {
    "sourceQueryCulture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "expressions": [],
    "annotations": [],
    "tables": [
      {
        "name": "Profiles",
        "columns": [
          { "name": "id", "dataType": "string", "sourceColumn": "id", "summarizeBy": "none" },
          { "name": "display_name", "dataType": "string", "sourceColumn": "display_name", "summarizeBy": "none" },
          { "name": "height_cm", "dataType": "double", "sourceColumn": "height_cm", "summarizeBy": "average" },
          { "name": "weight_kg", "dataType": "double", "sourceColumn": "weight_kg", "summarizeBy": "average" },
          { "name": "birth_year", "dataType": "int64", "sourceColumn": "birth_year", "summarizeBy": "none" },
          { "name": "gender", "dataType": "string", "sourceColumn": "gender", "summarizeBy": "none" },
          { "name": "fitness_goal", "dataType": "string", "sourceColumn": "fitness_goal", "summarizeBy": "none" },
          { "name": "calorie_target_kcal", "dataType": "int64", "sourceColumn": "calorie_target_kcal", "summarizeBy": "average" },
          { "name": "water_goal_ml", "dataType": "int64", "sourceColumn": "water_goal_ml", "summarizeBy": "average" },
          { "name": "sleep_cycle_target", "dataType": "int64", "sourceColumn": "sleep_cycle_target", "summarizeBy": "average" },
          { "name": "target_wake_time", "dataType": "string", "sourceColumn": "target_wake_time", "summarizeBy": "none" },
          { "name": "created_at", "dataType": "dateTime", "sourceColumn": "created_at", "summarizeBy": "none" }
        ],
        "partitions": [
          {
            "name": "Profiles",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Profiles = #table(",
                "        {\"id\", \"display_name\", \"height_cm\", \"weight_kg\", \"birth_year\", \"gender\", \"fitness_goal\", \"calorie_target_kcal\", \"water_goal_ml\", \"sleep_cycle_target\", \"target_wake_time\", \"created_at\"},",
                "        {{\"u-001\", \"Asha\", 168.0, 64.0, 1998, \"prefer_not_to_say\", \"maintain\", 2200, 2500, 5, \"06:30:00\", #datetime(2026, 1, 1, 0, 0, 0)}}",
                "    )",
                "in",
                "    Profiles"
              ]
            }
          }
        ]
      },
      {
        "name": "Nutrition Logs",
        "columns": [
          { "name": "id", "dataType": "string", "sourceColumn": "id", "summarizeBy": "none" },
          { "name": "user_id", "dataType": "string", "sourceColumn": "user_id", "summarizeBy": "none" },
          { "name": "entry_type", "dataType": "string", "sourceColumn": "entry_type", "summarizeBy": "none" },
          { "name": "title", "dataType": "string", "sourceColumn": "title", "summarizeBy": "none" },
          { "name": "meal_type", "dataType": "string", "sourceColumn": "meal_type", "summarizeBy": "none" },
          { "name": "logged_at", "dataType": "dateTime", "sourceColumn": "logged_at", "summarizeBy": "none" },
          { "name": "portion_g", "dataType": "double", "sourceColumn": "portion_g", "summarizeBy": "sum" },
          { "name": "volume_ml", "dataType": "int64", "sourceColumn": "volume_ml", "summarizeBy": "sum" },
          { "name": "calories_kcal", "dataType": "double", "sourceColumn": "calories_kcal", "summarizeBy": "sum", "formatString": "#,0 \"kcal\"" },
          { "name": "protein_g", "dataType": "double", "sourceColumn": "protein_g", "summarizeBy": "sum", "formatString": "#,0.0 \"g\"" },
          { "name": "carbs_g", "dataType": "double", "sourceColumn": "carbs_g", "summarizeBy": "sum", "formatString": "#,0.0 \"g\"" },
          { "name": "fats_g", "dataType": "double", "sourceColumn": "fats_g", "summarizeBy": "sum", "formatString": "#,0.0 \"g\"" },
          { "name": "estimate_source", "dataType": "string", "sourceColumn": "estimate_source", "summarizeBy": "none" },
          { "name": "created_at", "dataType": "dateTime", "sourceColumn": "created_at", "summarizeBy": "none" }
        ],
        "measures": [
          { "name": "Nutrition Entries", "expression": "COUNTROWS('Nutrition Logs')", "formatString": "#,0" },
          { "name": "Total Calories", "expression": "SUM('Nutrition Logs'[calories_kcal])", "formatString": "#,0 \"kcal\"" },
          { "name": "Total Protein", "expression": "SUM('Nutrition Logs'[protein_g])", "formatString": "#,0.0 \"g\"" },
          { "name": "Total Carbohydrates", "expression": "SUM('Nutrition Logs'[carbs_g])", "formatString": "#,0.0 \"g\"" },
          { "name": "Total Fat", "expression": "SUM('Nutrition Logs'[fats_g])", "formatString": "#,0.0 \"g\"" },
          { "name": "Average Calories per Entry", "expression": "AVERAGE('Nutrition Logs'[calories_kcal])", "formatString": "#,0 \"kcal\"" }
        ],
        "partitions": [
          {
            "name": "Nutrition Logs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    NutritionLogs = #table(",
                "        {\"id\", \"user_id\", \"entry_type\", \"title\", \"meal_type\", \"logged_at\", \"portion_g\", \"volume_ml\", \"calories_kcal\", \"protein_g\", \"carbs_g\", \"fats_g\", \"estimate_source\", \"created_at\"},",
                "        {{",
                "            {\"n-001\", \"u-001\", \"food\", \"Oats with berries\", \"Breakfast\", #datetime(2026, 11, 1, 8, 0, 0), 320.0, null, 410.0, 18.0, 62.0, 10.0, \"manual\", #datetime(2026, 11, 1, 8, 0, 0)},",
                "            {\"n-002\", \"u-001\", \"beverage\", \"Water\", \"Breakfast\", #datetime(2026, 11, 1, 9, 0, 0), null, 500, 0.0, 0.0, 0.0, 0.0, \"manual\", #datetime(2026, 11, 1, 9, 0, 0)},",
                "            {\"n-003\", \"u-001\", \"food\", \"Chicken rice bowl\", \"Lunch\", #datetime(2026, 11, 1, 13, 0, 0), 460.0, null, 620.0, 42.0, 68.0, 16.0, \"scan\", #datetime(2026, 11, 1, 13, 0, 0)},",
                "            {\"n-004\", \"u-001\", \"food\", \"Salmon and vegetables\", \"Dinner\", #datetime(2026, 11, 1, 19, 30, 0), 390.0, null, 540.0, 38.0, 31.0, 24.0, \"manual\", #datetime(2026, 11, 1, 19, 30, 0)},",
                "            {\"n-005\", \"u-001\", \"food\", \"Greek yoghurt\", \"Snack\", #datetime(2026, 11, 2, 16, 0, 0), 180.0, null, 190.0, 16.0, 20.0, 4.0, \"manual\", #datetime(2026, 11, 2, 16, 0, 0)},",
                "            {\"n-006\", \"u-001\", \"food\", \"Lentil curry\", \"Dinner\", #datetime(2026, 11, 2, 19, 0, 0), 420.0, null, 580.0, 27.0, 74.0, 15.0, \"scan\", #datetime(2026, 11, 2, 19, 0, 0)},",
                "            {\"n-007\", \"u-001\", \"beverage\", \"Green tea\", \"Snack\", #datetime(2026, 11, 3, 16, 30, 0), null, 300, 4.0, 0.0, 1.0, 0.0, \"manual\", #datetime(2026, 11, 3, 16, 30, 0)},",
                "            {\"n-008\", \"u-001\", \"food\", \"Paneer salad\", \"Lunch\", #datetime(2026, 11, 3, 13, 15, 0), 350.0, null, 470.0, 29.0, 34.0, 21.0, \"manual\", #datetime(2026, 11, 3, 13, 15, 0)}",
                "        }}",
                "    )",
                "in",
                "    NutritionLogs"
              ]
            }
          }
        ]
      },
      {
        "name": "Daily Health Logs",
        "columns": [
          { "name": "id", "dataType": "string", "sourceColumn": "id", "summarizeBy": "none" },
          { "name": "user_id", "dataType": "string", "sourceColumn": "user_id", "summarizeBy": "none" },
          { "name": "log_date", "dataType": "dateTime", "sourceColumn": "log_date", "summarizeBy": "none" },
          { "name": "steps", "dataType": "int64", "sourceColumn": "steps", "summarizeBy": "sum", "formatString": "#,0" },
          { "name": "heart_rate_bpm", "dataType": "int64", "sourceColumn": "heart_rate_bpm", "summarizeBy": "average", "formatString": "#,0 \"bpm\"" },
          { "name": "sleep_hours", "dataType": "double", "sourceColumn": "sleep_hours", "summarizeBy": "average", "formatString": "#,0.0 \"h\"" },
          { "name": "water_ml", "dataType": "int64", "sourceColumn": "water_ml", "summarizeBy": "sum", "formatString": "#,0 \"ml\"" },
          { "name": "created_at", "dataType": "dateTime", "sourceColumn": "created_at", "summarizeBy": "none" },
          { "name": "updated_at", "dataType": "dateTime", "sourceColumn": "updated_at", "summarizeBy": "none" }
        ],
        "measures": [
          { "name": "Health Days", "expression": "COUNTROWS('Daily Health Logs')", "formatString": "#,0" },
          { "name": "Total Steps", "expression": "SUM('Daily Health Logs'[steps])", "formatString": "#,0" },
          { "name": "Average Steps", "expression": "AVERAGE('Daily Health Logs'[steps])", "formatString": "#,0" },
          { "name": "Average Sleep", "expression": "AVERAGE('Daily Health Logs'[sleep_hours])", "formatString": "#,0.0 \"h\"" },
          { "name": "Average Heart Rate", "expression": "AVERAGE('Daily Health Logs'[heart_rate_bpm])", "formatString": "#,0 \"bpm\"" },
          { "name": "Total Water", "expression": "SUM('Daily Health Logs'[water_ml])", "formatString": "#,0 \"ml\"" },
          { "name": "Average Water", "expression": "AVERAGE('Daily Health Logs'[water_ml])", "formatString": "#,0 \"ml\"" }
        ],
        "partitions": [
          {
            "name": "Daily Health Logs",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    DailyHealthLogs = #table(",
                "        {\"id\", \"user_id\", \"log_date\", \"steps\", \"heart_rate_bpm\", \"sleep_hours\", \"water_ml\", \"created_at\", \"updated_at\"},",
                "        {{",
                "            {\"h-001\", \"u-001\", #datetime(2026, 11, 1, 0, 0, 0), 8420, 72, 7.5, 2200, #datetime(2026, 11, 1, 23, 0, 0), #datetime(2026, 11, 1, 23, 0, 0)},",
                "            {\"h-002\", \"u-001\", #datetime(2026, 11, 2, 0, 0, 0), 10120, 70, 8.0, 2450, #datetime(2026, 11, 2, 23, 0, 0), #datetime(2026, 11, 2, 23, 0, 0)},",
                "            {\"h-003\", \"u-001\", #datetime(2026, 11, 3, 0, 0, 0), 7680, 74, 6.8, 1900, #datetime(2026, 11, 3, 23, 0, 0), #datetime(2026, 11, 3, 23, 0, 0)},",
                "            {\"h-004\", \"u-001\", #datetime(2026, 11, 4, 0, 0, 0), 11840, 68, 7.8, 2700, #datetime(2026, 11, 4, 23, 0, 0), #datetime(2026, 11, 4, 23, 0, 0)},",
                "            {\"h-005\", \"u-001\", #datetime(2026, 11, 5, 0, 0, 0), 9340, 71, 7.2, 2300, #datetime(2026, 11, 5, 23, 0, 0), #datetime(2026, 11, 5, 23, 0, 0)},",
                "            {\"h-006\", \"u-001\", #datetime(2026, 11, 6, 0, 0, 0), 12600, 69, 8.4, 2900, #datetime(2026, 11, 6, 23, 0, 0), #datetime(2026, 11, 6, 23, 0, 0)},",
                "            {\"h-007\", \"u-001\", #datetime(2026, 11, 7, 0, 0, 0), 10980, 70, 7.9, 2550, #datetime(2026, 11, 7, 23, 0, 0), #datetime(2026, 11, 7, 23, 0, 0)}",
                "        }}",
                "    )",
                "in",
                "    DailyHealthLogs"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Nutrition to Profiles",
        "fromTable": "Nutrition Logs",
        "fromColumn": "user_id",
        "toTable": "Profiles",
        "toColumn": "id",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Health to Profiles",
        "fromTable": "Daily Health Logs",
        "fromColumn": "user_id",
        "toTable": "Profiles",
        "toColumn": "id",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}
